<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.carriez.flutter_hbb">
    <!-- Waldlust(DSK-12): 발신 전용(직원 개인 폰, WALDLUST_VARIANT=outgoing) 빌드만 build.gradle 이 debug·profile·release
         매니페스트로 쓴다. 원격을 받지 않으므로 피제어(무인 운용) 권한·구성요소를 main 에서 뺀다.
         남기는 것: RECORD_AUDIO(원격 화면 채팅 메뉴의 음성 통화), 저장소 권한(파일 전송), FileProvider(받은 파일 열기). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="co.kr.waldlust.remote.permission.INPUT_BRIDGE" tools:node="remove" />
    <permission android:name="co.kr.waldlust.remote.permission.INPUT_BRIDGE" tools:node="remove" />
    <!-- 폰은 QR 스캔(설정 화면 스캔 버튼)을 두지 않는다 — qr_code_scanner 라이브러리가 넣는 카메라 권한(부록 A-58) -->
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove" />

    <application>
        <receiver android:name="com.carriez.flutter_hbb.BootReceiver" tools:node="remove" />
        <receiver android:name="com.carriez.flutter_hbb.WaldHelperInstallReceiver" tools:node="remove" />
        <receiver android:name="com.carriez.flutter_hbb.WaldSelfUpdateReceiver" tools:node="remove" />
        <receiver android:name="com.carriez.flutter_hbb.WaldUpdatedReceiver" tools:node="remove" />
        <service android:name="com.carriez.flutter_hbb.InputService" tools:node="remove" />
        <service android:name="com.carriez.flutter_hbb.MainService" tools:node="remove" />
        <service android:name="com.carriez.flutter_hbb.FloatingWindowService" tools:node="remove" />
        <activity android:name="com.carriez.flutter_hbb.WaldWakeActivity" tools:node="remove" />
    </application>
</manifest>
