<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 원격 앱 → 도우미 입력 브리지(InputBridgeService)를 같은 서명 앱만 바인딩하게 한다(2단계 — 결정 D41).
         원격 앱 매니페스트에도 똑같이 선언한다 — 같은 서명이면 둘 다 선언해도 되고, 어느 쪽이 먼저 깔려도 권한이 생긴다. -->
    <permission
        android:name="co.kr.waldlust.remote.permission.INPUT_BRIDGE"
        android:protectionLevel="signature" />

    <!-- 메인 앱(co.kr.waldlust.remote)을 깨우려면 그 패키지가 보여야 한다(Android 11+ 패키지 가시성) -->
    <queries>
        <package android:name="co.kr.waldlust.remote" />
    </queries>

    <!-- 런처 아이콘은 없다(결정 D40 — AnyDesk 플러그인처럼). 런처 화면을 선언하지 않아 Android 10+ 의 '앱 정보' 대체 아이콘도 생기지 않는다.
         설정 → 애플리케이션 목록에는 보인다. -->
    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name">

        <!-- 부팅 때 메인 앱을 깨운다. 메인 앱이 강제 종료돼 stopped 라도 이 앱은 따로라 부팅 신호를 받는다.
             부팅 신호는 앱마다 차례로 전달돼, 기본 우선순위면 RK3568 키오스크에서 67초 늦게 받았다 → 메인 앱과 같은 1000.
             ACTIVATE 는 메인 앱(1.5.5+)이 켜질 때 보내 이 앱의 stopped 상태(새로 설치하면 stopped)를 푸는 신호다 — 받기만 한다. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="co.kr.waldlust.remote.helper.ACTIVATE" />
            </intent-filter>
        </receiver>

        <!-- 메인 앱을 한 번 깨우고 바로 닫힌다(화면 없음). 아이콘이 없어 adb 로만 연다:
             adb shell am start -n co.kr.waldlust.remote.helper/.WakeActivity
             (메인 앱 1.5.4 이하에서 도우미 stopped 를 풀 때, 화면 공유가 빠진 기기를 되살릴 때) -->
        <activity
            android:name=".WakeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 입력 제어(접근성) — 2단계(결정 D41). 원격 앱의 InputService 를 옮겨 왔다. 원격 앱과 다른 패키지라
             원격 앱을 강제 종료해도 시스템이 이 접근성을 끄지 않는다(AnyDesk 플러그인 ad1 과 같은 구조).
             원격 앱이 PackageInstaller 세션으로 설치해 Android 13·14 '제한된 설정'에 걸리지 않는다. -->
        <service
            android:name=".InputService"
            android:enabled="true"
            android:exported="false"
            android:label="@string/input_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 원격 앱이 입력을 보내는 브리지. 원격 앱은 이 액션으로 도우미에 입력 기능이 있는지 판단한다(r3·1.5.5 이전 도우미에는 없음). -->
        <service
            android:name=".InputBridgeService"
            android:exported="true"
            android:permission="co.kr.waldlust.remote.permission.INPUT_BRIDGE">
            <intent-filter>
                <action android:name="co.kr.waldlust.remote.helper.INPUT_BRIDGE" />
            </intent-filter>
        </service>
    </application>

</manifest>
