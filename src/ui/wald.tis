};

// ---------------------------------------------------------------- 메인 창(수신 전용)

// Flutter 수신 전용 창의 보이는 폭 283(왼쪽 패널 280 + 3) + 좌우 테두리 1px.
const wald_home_width = 285;

// 창 틀: Flutter 처럼 제목 표시줄을 직접 그리고, 크기 조절·최대화는 막는다. 높이는 내용에 맞춘다.
function waldInitHomeWindow() {
    view.windowFrame = #solid-with-shadow;
    view.windowResizable = false;
    view.windowMaximizable = false;
    view.windowMinSize = (scaleIt(100), scaleIt(100));
    // 작업 표시줄은 exe 아이콘(res/icon.ico — 수신 전용은 ↓ 배지)을 쓴다. common.tis 가 넣은 get_icon() 은 제목 표시줄용 W. 다.
    view.windowIcon = null;
    self.attributes.addClass("wald-incoming");
    waldFitHomeLoop();
    waldUpdateLoop();
}

// 상태 문구가 줄바꿈되거나 카드가 바뀌면 높이가 달라진다(Flutter `_updateWindowSize` 와 같은 역할).
function waldFitHomeLoop() {
    self.timer(300ms, function() {
        waldFitHome();
        waldFitHomeLoop();
    });
}

function waldFitHome() {
    var root = $(div.wald-home);
    if (!root || view.windowState != View.WINDOW_SHOWN) return;
    var body = $(body);
    var frame = body.box(#height, #border) - body.box(#height, #padding);
    var want_h = root.box(#height, #margin) + frame;
    var want_w = scaleIt(wald_home_width);
    var (x, y, w, h) = view.box(#rectw, #border, #screen);
    var dh = h - want_h;
    if (w != want_w || dh > 1 || dh < -1) view.move(x, y, want_w, want_h);
}

function waldHome() {
    return <div .wald-main>
        <div .wald-titlebar>
            <div .wald-caption role="window-caption">
                <icon .wald-appicon style={"background-image: url('" + handler.get_icon() + "')"} />
                <div .wald-appname>{translate('wald-app-display-name')}</div>
            </div>
            <div .wald-winbtn role="window-minimize" title={translate('Minimize')}>{wald_svg.minus}</div>
            <div .wald-winbtn .disabled>{wald_svg.square}</div>
            <div .wald-winbtn #wald-close role="window-close" title={translate('Close')}>{wald_svg.x}</div>
        </div>
        <div .wald-pane>
            <div .wald-tip>
                <div .wald-title>{translate('Your Desktop')}</div>
                <div .wald-desk-tip>{translate('desk_tip')}</div>
            </div>
            <div .wald-board .wald-id>
                <div .wald-bar />
                <div .wald-board-body>
                    <div .wald-label-row>
                        <div .wald-label>{translate('ID')}</div>
                        <div .wald-about-btn #wald-about title={translate('About')}>{wald_svg.info}</div>
                    </div>
                    <div .wald-id-value>{key_confirmed ? formatId(get_id()) : translate("Generating ...")}</div>
                </div>
            </div>
            <WaldPasswordBoard />
            {waldHelpCard()}
            {waldLegal()}
        </div>
        <div style="position:absolute; left:-10000px; top:-10000px; width:0; height:0; overflow:hidden"><MyIdMenu /></div>
    </div>;
}

// 부록 A-39: 정보(i) 대화상자 — Flutter showWaldAppInfo(flutter/lib/common/widgets/wald_app_info.dart)와 같은 항목.
// 수신 전용은 설정이 잠겨(disable-settings) 버전을 볼 곳이 없다. 업스트림 showAbout(index.tis)은 rustdesk.com 링크라 쓰지 않는다.
// 화면 글자는 ASCII 만(위 waldLegal 주석) — 이름은 translate('wald-app-display-name'), '(c)' 기호는 \u00A9 로 넣는다.
// 상태 줄까지 덮도록 index.tis App.render 의 div.wald-home 끝에 그린다.
const WALD_PRIVACY_URL = "https://remote.waldpay.co.kr/privacy";
var wald_about_open = false;

function waldAbout() {
    var year = (new Date()).year;
    return <div .wald-dialog-mask #wald-about-mask>
        <div .wald-dialog>
            <div .wald-dialog-title>{translate('wald-app-display-name')}</div>
            <div .wald-info-row><div .wald-info-label>{translate('Version')}</div><div .wald-info-value>{handler.get_version()}</div></div>
            <div .wald-info-row><div .wald-info-label>{translate('Build Date')}</div><div .wald-info-value>{handler.get_build_date()}</div></div>
            {waldUpdateAboutRow()}
            <div .wald-dialog-divider />
            <div .wald-info-link #wald-about-privacy>{translate('Privacy Statement')}{wald_svg.externalLink}</div>
            <div .wald-info-link #wald-about-oss>{translate('Open source notices')}{wald_svg.externalLink}</div>
            <div .wald-info-copyright>
                {"Copyright \u00A9 " + year + " Purslane Ltd."}<br />
                {"Modifications \u00A9 2026 Waldlust Co., Ltd."}<br />
                {"Licensed under the GNU AGPL-3.0, without any warranty."}
            </div>
            <div .wald-dialog-actions>{waldUpdateAboutActions()}</div>
        </div>
    </div>;
}

function waldSetAbout(open) {
    if (wald_about_open == open) return;
    wald_about_open = open;
    if (open) waldUpdateCheckNow();
    app.update();
}
// 위 화면 밖 MyIdMenu: 업스트림 상태 갱신(checkConnectStatus 등)이 myIdMenu 를 부르므로 둔다. 설정 진입점(⋮)은 없다 — DSK-02.

// D35(부록 A-25): 원저작물·소스 위치·제3자 고지 링크(Flutter loadPowered 와 같은 문구)와
// Sciter 무료 라이선스가 요구하는 표기(About 또는 비슷한 곳에 Terra Informatica 링크 — sciter-sdk license.htm).
// 화면 글자는 ASCII 만 쓴다 — Sciter 가 인라인 HTML 을 시스템 코드페이지(cp949)로 읽어 '©'(UTF-8 C2 A9)가 '짤'로 보였다.
const WALD_OSS_URL = "https://remote.waldpay.co.kr/oss";
function waldLegal() {
    return <div .wald-legal>
        <div .wald-legal-link #wald-oss>{translate('powered_by_me')}</div>
        <div .wald-legal-link #wald-sciter title="This Application uses Sciter Engine (http://sciter.com/), copyright Terra Informatica Software, Inc.">
            This application uses Sciter Engine (sciter.com), copyright Terra Informatica Software, Inc.
        </div>
    </div>;
}

// 설치 안 됨 → 어두운 설치 카드, 낮은 버전 → 업그레이드 카드, 그 밖 → 오른쪽 '종료' 버튼(Flutter buildHelpCards).
function waldHelpCard() {
    if (system_error) {
        return <div .wald-card><div .wald-card-text>{system_error}</div></div>;
    }
    if (is_win && !disable_installation) {
        if (!handler.is_installed()) {
            return <div .wald-card>
                <div .wald-card-text>{translate('install_tip')}</div>
                <div .wald-card-btns><button .wald-card-btn #wald-install>{translate('Install')}</button></div>
            </div>;
        }
        if (handler.is_installed_lower_version()) {
            return <div .wald-card>
                <div .wald-card-title>{translate('Status')}</div>
                <div .wald-card-text>{translate('Your installation is lower version.')}</div>
                <div .wald-card-btns><button .wald-card-btn #wald-upgrade>{translate('Click to upgrade')}</button></div>
            </div>;
        }
    }
    return <div .wald-quit-row><button .wald-btn-outline #wald-quit>{translate('Quit')}</button></div>;
}

// ---------------------------------------------------------------- 앱 안 업데이트(명세 DSK-01 — 결정 D44, 부록 A-62)
// 확인·받기·설치는 Rust(src/wald_update.rs)가 한다. 설치본이면 서비스(SYSTEM)가 UAC 없이 조용히 설치하고 앱을 다시 띄운다.
// 이 화면은 handler.wald_update_state()(캐시 — 막지 않는다)를 읽어 그리고, handler.wald_update_cmd(키)로 시작·취소·설치를 보낸다.
// 문구·흐름은 Flutter desktop/widgets/wald_update.dart 와 같다: 홈 카드 없이(2026-10-26 사용자) 정보(i)를 열 때 확인해
// 최신 버전을 보이고, [업데이트]를 누르면 확인 창 없이 바로 받는다.
var wald_update = {};
var wald_update_raw = "";
var wald_update_dialog = ""; // "" | progress | error
var wald_update_install_sent = false;

function waldUpdateLoop() {
    self.timer(wald_update_dialog == "progress" ? 500ms : 2s, function() {
        waldUpdatePoll();
        waldUpdateLoop();
    });
}

function waldUpdatePoll() {
    var raw = handler.wald_update_state();
    if (!raw || raw == wald_update_raw) return;
    wald_update_raw = raw;
    try { wald_update = JSON.parse(raw); } catch(e) { wald_update = {}; }
    var job = wald_update.job || {};
    if (wald_update_dialog == "progress") {
        if (job.state == "ready" && !wald_update_install_sent) {
            wald_update_install_sent = true;
            handler.wald_update_cmd("wald-update-install");
        } else if (job.state == "error") {
            wald_update_dialog = "error";
        } else if (job.state == "idle") {
            wald_update_dialog = ""; // 받기 취소
        }
    }
    app.update();
}

function waldUpdateMb(b) {
    return String.printf("%.1f", (b || 0) / 1048576.0);
}

function waldUpdateDialog() {
    var latest = wald_update.latest || {};
    var job = wald_update.job || {};
    var body;
    var actions;
    if (wald_update_dialog == "progress") {
        var text;
        if (job.state == "downloading") {
            text = translate('wald-update-downloading') + (job.total > 0 ? "  " + waldUpdateMb(job.done) + " / " + waldUpdateMb(job.total) + " MB" : "");
        } else if (job.state == "verifying") {
            text = translate('wald-update-verifying');
        } else {
            text = translate(wald_update.mode == "service" ? 'wald-update-installing-field-tip' : 'wald-update-installing-uac-tip');
        }
        var pct = job.state == "downloading" && job.total > 0 ? (job.done * 100 / job.total) : 100;
        body = <div>
            <div .wald-update-bar><div .wald-update-fill style={"width:" + pct + "%"} /></div>
            <div .wald-update-text>{text}</div>
        </div>;
        actions = job.state == "downloading" ? [<button .wald-btn-outline #wald-update-stop>{translate('Cancel')}</button>] : [];
    } else {
        body = <div>
            <div .wald-update-text>{translate('wald-update-error-' + (job.error || 'install'))}</div>
            {job.detail ? <div .wald-update-detail>{job.detail}</div> : ""}
        </div>;
        actions = [<button .wald-btn-outline #wald-update-close>{translate('Close')}</button>,
            <button .wald-btn-primary #wald-update-retry>{translate('Retry')}</button>];
    }
    return <div .wald-dialog-mask>
        <div .wald-dialog>
            <div .wald-dialog-title>{translate('wald-update-dialog-title')}</div>
            {body}
            <div .wald-dialog-actions>{actions}</div>
        </div>
    </div>;
}

// 정보(i) 대화상자의 '최신 버전' 줄 — 버전·빌드 날짜 줄과 같은 모양. [업데이트]는 대화상자 버튼(waldUpdateAboutActions).
function waldUpdateAboutRow() {
    var status = wald_update.status;
    var latest = wald_update.latest || {};
    var value = status == "checking" ? translate('wald-update-checking')
        : status == "error" ? translate('wald-update-check-failed')
        : (latest.version || "-");
    return <div .wald-info-row>
        <div .wald-info-label>{translate('wald-update-latest-label')}</div>
        <div .wald-info-value style={status == "available" ? "font-weight:bold" : ""}>{value}</div>
    </div>;
}

// 정보(i) 대화상자의 버튼: 새 버전이 있으면 [닫기][업데이트], 없으면 [닫기].
function waldUpdateAboutActions() {
    if (wald_update.status != "available") return <button .wald-btn-primary #wald-about-close>{translate('Close')}</button>;
    return [<button .wald-btn-outline #wald-about-close>{translate('Close')}</button>,
        <button .wald-btn-primary #wald-update>{translate('Update')}</button>];
}

// 정보(i)를 열 때마다 확인한다(Flutter WaldUpdateAboutRow compact 와 같다). 결과는 2초 폴링으로 들어온다.
function waldUpdateCheckNow() {
    if (wald_update.status == "checking") return;
    wald_update.status = "checking";
    handler.wald_update_cmd("wald-update-check");
}

function waldSetUpdateDialog(d) {
    wald_update_dialog = d;
    app.update();
}

// 정보(i)의 [업데이트]·오류 창의 [다시 시도]: 확인 창 없이 바로 받는다.
function waldUpdateStart() {
    var latest = wald_update.latest || {};
    wald_about_open = false;
    // 받기 주소가 없으면(어드민에 해시·받기 키 설정이 없다) 앱에서 받을 수 없다.
    if (!latest.download) {
        wald_update.job = { state: "error", error: "unavailable" };
        waldSetUpdateDialog("error");
        return;
    }
    wald_update_install_sent = false;
    handler.wald_update_cmd("wald-update-start");
    waldSetUpdateDialog("progress");
}

event click $(#wald-update) {
    waldUpdateStart();
}

event click $(#wald-update-stop) {
    handler.wald_update_cmd("wald-update-cancel");
}

event click $(#wald-update-retry) {
    waldUpdateStart();
}

event click $(#wald-update-close) {
    waldSetUpdateDialog("");
}

// 업스트림 updatePasswordArea() 가 비밀번호가 바뀔 때 passwordArea.update() 를 부른다.
class WaldPasswordBoard: Reactor.Component {
    function this() {
        passwordArea = this;
    }

    function render() {
        var method = handler.get_option('verification-method');
        var mode = handler.get_option('approve-mode');
        var hide_one_time = mode == 'click' || method == 'use-permanent-password';
        return <div .wald-board .wald-pw>
            <div .wald-bar />
            <div .wald-board-body>
                <div .wald-label>{translate('One-time Password')}</div>
                <div .wald-pw-row>
                    <div .wald-pw-value>{hide_one_time ? "-" : password_cache[0]}</div>
                    {hide_one_time ? "" : <div .wald-refresh title={translate('Refresh Password')}>{wald_svg.refreshCw}</div>}
                </div>
            </div>
        </div>;
    }

    event click $(div.wald-refresh) {
        handler.update_temporary_password();
        this.update();
    }
}

// 상태 줄: 점(중지·연결 중 주황, 준비 초록, 그 밖 빨강) + 문구, 중지면 아래 줄에 '서비스 시작' 링크.
// 수신 전용에서는 '자신만의 서버를 설정' 링크를 두지 않는다(Flutter 와 같음).
class WaldConnectStatus: Reactor.Component {
    function render() {
        var dot;
        var text;
        if (service_stopped) {
            dot = "wait";
            text = translate("Service is not running");
        } else if (connect_status == 0) {
            dot = "wait";
            text = translate("connecting_status");
        } else if (connect_status == 1) {
            dot = "ready";
            text = translate("Ready");
        } else {
            dot = "error";
            text = translate("not_ready_status");
        }
        return <div .wald-status>
            <div .wald-status-row>
                <span class={"wald-dot wald-dot-" + dot} />
                <div .wald-status-text>{text}</div>
            </div>
            {service_stopped ? <div .wald-start-service>{translate("Start service")}</div> : ""}
        </div>;
    }

    event click $(div.wald-start-service) {
        handler.set_option("stop-service", "");
    }
}

event dblclick $(div.wald-id-value) {
    if (!key_confirmed) return;
    view.clipboard(#put, get_id());
    waldToast(translate("Copied"));
}

event click $(#wald-install) {
    handler.goto_install();
}

event click $(#wald-upgrade) {
    handler.update_me("");
}

event click $(#wald-quit) {
    view.close();
}

event click $(#wald-oss) {
    handler.open_url(WALD_OSS_URL);
}

event click $(#wald-sciter) {
    handler.open_url("http://sciter.com/");
}

event click $(#wald-about) {
    waldSetAbout(true);
}

event click $(#wald-about-close) {
    waldSetAbout(false);
}

event click $(#wald-about-privacy) {
    handler.open_url(WALD_PRIVACY_URL);
}

event click $(#wald-about-oss) {
    handler.open_url(WALD_OSS_URL);
}

// 바깥(어두운 바탕)을 누르거나 Esc 면 닫는다(Flutter clickMaskDismiss·Esc 와 같음).
event click $(#wald-about-mask) (evt, me) {
    if (evt.target === me) waldSetAbout(false);
}

event keydown (evt) {
    if (wald_about_open && evt.keyCode == Event.VK_ESCAPE) {
        waldSetAbout(false);
        return true;
    }
}

// Flutter showToast 처럼 아래쪽에 잠깐 띄운다.
function waldToast(text) {
    var old = $(div.wald-toast);
    if (old) old.remove();
    var el = new Element("div", text);
    el.attributes.addClass("wald-toast");
    $(div.wald-home).append(el);
    self.timer(2s, function() { if (el.parent) el.remove(); });
}

// ---------------------------------------------------------------- 연결 관리(CM) 창
// 배치 정본: flutter/lib/desktop/pages/server_page.dart (_CmHeader, _PrivilegeBoard, _CmControlPanel).
// 클릭 처리는 cm.tis 의 업스트림 핸들러(icon.keyboard·button#disconnect 등)를 그대로 쓴다 — 선택자를 맞춘다.

function waldInitCm() {
    view.windowFrame = #solid-with-shadow;
    self.attributes.addClass("wald-cm");
    waldCmTimeLoop();
}

function waldCmBody(me) {
    if (connections.length == 0) return <div .wald-cm-waiting>{translate('Waiting')}</div>;
    var c = connections[me.cur];
    me.connection = c;
    me.cid = c.id;
    var auth = c.authorized;
    var disconnected = c.disconnected;
    var callback = function(msg) {
        me.sendMsg(msg);
    };
    var show_elevation_btn = handler.can_elevate() && show_elevation && !c.is_file_transfer && !c.is_view_camera && !c.is_terminal && c.port_forward.length == 0;
    var show_accept_btn = handler.get_option('approve-mode') != 'password';
    var no_board = c.is_file_transfer || c.is_terminal || c.port_forward || disconnected;
    var has_chat = !c.is_file_transfer && !c.is_terminal && !c.port_forward;
    return <div .content style="size:*">
        <div .left-panel .wald-cm-panel>
            {waldCmHeader(c, auth && has_chat)}
            {no_board ? "" : waldCmPermissions(c, !allow_perm_change_in_accept_window)}
            <div .wald-cm-spacer />
            {waldCmButtons(auth, disconnected, show_elevation_btn, show_accept_btn)}
        </div>
        <div .right-panel style={show_chat ? "" : "display: none"}>
            {has_chat ? <ChatBox msgs={c.msgs} callback={callback} /> : ""}
        </div>
    </div>;
}

// 머리 카드: n900·반경 8, 아바타 70(반경 15), ID 20 굵게, 종류 12, 상태 + 경과 시간, 채팅 아이콘.
// 접속한 쪽 이름(c.name)은 보이지 않는다 — 아바타는 이름 첫 글자·계정 사진 대신 같은 사람 아이콘(부록 A-31).
function waldCmHeader(c, show_chat_icon) {
    var auth = c.authorized;
    var kind = c.is_file_transfer ? translate('Transfer file')
        : c.is_view_camera ? translate('View camera')
        : c.is_terminal ? translate('Terminal')
        : c.port_forward ? "Port Forward: " + c.port_forward : "";
    var state = auth ? (c.disconnected ? translate('Disconnected') : translate('Connected'))
        : translate('Request access to your device') + "...";
    return <div .wald-cm-header>
        <div .wald-cm-avatar>{wald_svg.user}</div>
        <div .wald-cm-who>
            <div .wald-cm-name>{c.peer_id}</div>
            {kind ? <div .wald-cm-kind>{kind}</div> : ""}
            <div .wald-cm-state>{state}{auth ? " " : ""}{auth ? <span #wald-time>{waldElapsed(c.time, c.now)}</span> : ""}</div>
        </div>
        {show_chat_icon ? <div .chaticon>{wald_svg.messageSquare}</div> : ""}
    </div>;
}

// 권한 보드: '권한' 16 굵게, 4열 정사각 타일(반경 8, 흰 아이콘 24), 켜짐 파랑·꺼짐 n600·바꿀 수 없으면 흐리게.
function waldCmPermissions(c, locked) {
    function tile(name, on, svg, label, show = true) {
        if (!show) return "";
        return <icon class={name + " wald-tile" + (on ? " on" : "") + (locked ? " locked" : "")}
            title={label + ": " + (on ? "ON" : "OFF")}>{svg}</icon>;
    }
    return <div .wald-perm-board>
        <div .wald-perm-title>{translate('Permissions')}</div>
        <div .wald-perm-grid>
            {tile("keyboard", c.keyboard, wald_svg.keyboard, translate('Enable keyboard/mouse'))}
            {tile("clipboard", c.clipboard, wald_svg.clipboardList, translate('Enable clipboard'))}
            {tile("audio", c.audio, wald_svg.volume2, translate('Enable audio'))}
            {tile("file", c.file, wald_svg.upload, translate('Enable file copy and paste'))}
            {tile("restart", c.restart, wald_svg.rotateCcw, translate('Enable remote restart'))}
            {tile("recording", c.recording, wald_svg.video, translate('Enable recording session'))}
            {tile("block_input", c.block_input, wald_svg.ban, translate('Enable blocking user input'), is_win)}
            {tile("privacy_mode", c.privacy_mode, wald_svg.eyeOff, translate('Enable privacy mode'), is_privacy_mode_supported)}
        </div>
    </div>;
}

// 버튼(높이 32, 반경 8, 아이콘 14): 연결 해제 = red600, 권한 상승·수락·닫기 = n900, 수락 및 권한 상승 = green600, 취소 = 테두리.
function waldCmButtons(auth, disconnected, show_elevation_btn, show_accept_btn) {
    if (auth && disconnected) {
        return <div .wald-cm-buttons><button #close .wald-cm-btn .primary>{waldBtnLabel(null, translate('Close'))}</button></div>;
    }
    if (auth) {
        return <div .wald-cm-buttons>
            {show_elevation_btn ? <button #elevate .wald-cm-btn .primary>{waldBtnLabel(wald_svg.shieldCheck, translate('Elevate'))}</button> : ""}
            <button #disconnect .wald-cm-btn .danger>{waldBtnLabel(wald_svg.unlink, translate('Disconnect'))}</button>
        </div>;
    }
    return <div .wald-cm-buttons>
        {show_elevation_btn && show_accept_btn ? <button #elevate_accept .wald-cm-btn .success>{waldBtnLabel(wald_svg.shieldCheck, translate('Accept and Elevate'))}</button> : ""}
        <div .wald-cm-row>
            {show_accept_btn ? <button #accept .wald-cm-btn .primary>{waldBtnLabel(null, translate('Accept'))}</button> : ""}
            <button #dismiss .wald-cm-btn .outline>{waldBtnLabel(null, translate('Cancel'))}</button>
        </div>
    </div>;
}

// 아이콘 + 글자를 버튼 가운데에 한 줄로.
function waldBtnLabel(svg, text) {
    return <span .wald-btn-in>{svg ? svg : ""}<span>{text}</span></span>;
}

// Flutter formatDurationToTime 처럼 시:분:초(업스트림 getElapsed 는 하루가 넘으면 영어 'day(s)' 를 붙인다).
function waldElapsed(time, now) {
    var seconds = Date.diff(time, now, #seconds);
    return String.printf("%02d:%02d:%02d", seconds / 3600, seconds % 3600 / 60, seconds % 60);
}

function waldCmTimeLoop() {
    self.timer(1s, function() {
        var el = $(#wald-time);
        if (el && body) {
            var c = connections[body.cur];
            if (c && c.authorized && !c.disconnected) el.text = waldElapsed(c.time, c.now);
        }
        waldCmTimeLoop();
    });
}

// ---------------------------------------------------------------- 설치 화면
// 배치 정본: flutter/lib/desktop/pages/install_page.dart. 클릭 처리는 install.tis 의 업스트림 핸들러(#submit 등)를 쓴다.
// '경로 변경'(#path)은 두지 않는다 — 설치 경로는 전용 폴더로 고정(부록 A-21, POS 폴더 보호).

function waldInstall() {
    const install_options = JSON.parse(view.install_options());
    const desktop_icon = { checked: install_options?.DESKTOPSHORTCUTS == '0' ? false : true };
    const startmenu_shortcuts = { checked: install_options?.STARTMENUSHORTCUTS == '0' ? false : true };
    return <div .content .wald-install>
        <div .wald-install-title>{translate('Installation')}</div>
        <div .wald-install-path>
            <div .wald-install-label>{translate('Installation Path') + ":"}</div>
            <input|text disabled value={view.install_path()} #path_input />
        </div>
        <div .wald-install-opt><button|checkbox #startmenu {startmenu_shortcuts}>{translate('Create start menu shortcuts')}</button></div>
        <div .wald-install-opt><button|checkbox #desktopicon {desktop_icon}>{translate('Create desktop icon')}</button></div>
        <div .wald-install-note>
            {wald_svg.info}
            <div>
                <div>{translate('agreement_tip')}</div>
                <div #agreement .wald-link>{translate('End-user license agreement')}</div>
            </div>
        </div>
        <div .wald-install-actions>
            <div .wald-install-progress><progress style="display: none" /></div>
            <button .wald-btn-outline #cancel>{translate('Cancel')}</button>
            <button .wald-btn-primary #submit>{translate('Accept and Install')}</button>
            {handler.show_run_without_install() ? <button .wald-btn-outline #run-without-install>{translate('Run without install')}</button> : ""}
        </div>
    </div>;
}

